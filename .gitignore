# Monorepo ignore rules

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Global env files
.env
.env.*

# Build artifacts and dependencies
CLIENT/node_modules
CLIENT/dist
CLIENT/dist-ssr
CLIENT/*.local
SERVER/node_modules
SERVER/dist
SERVER/.env
SERVER/.env.*
SERVER/schedule_parser/schedule

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
